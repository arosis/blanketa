<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/vnd.software602.filler.form-xml-zip">
    <comment>Formulář 602XML nebo datová zpráva (ZFO)</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.zfo"/>
  </mime-type>
  <mime-type type="application/vnd.software602.filler.form+xml">
    <comment>Formulář 602XML (FO)</comment>
    <sub-class-of type="application/xml"/>
    <glob pattern="*.fo" weight="60"/>
  </mime-type>
  <mime-type type="application/vnd.etsi.asic-e+zip">
    <comment>Kontejner ASiC s podpisy (ASiC-E)</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.asice"/>
    <glob pattern="*.sce"/>
  </mime-type>
  <mime-type type="application/vnd.etsi.asic-s+zip">
    <comment>Kontejner ASiC s podpisy (ASiC-S)</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.asics"/>
    <glob pattern="*.scs"/>
  </mime-type>
</mime-info>
