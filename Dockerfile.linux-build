# Builds the Linux packages (dist/*.deb, dist/*.tar.gz) in a clean Ubuntu, and can run the app under Xvfb:
#   docker build -f Dockerfile.linux-build -t blanketa-build . && docker run --rm -v "$PWD/dist:/src/dist" blanketa-build
FROM ubuntu:24.04@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852
ENV DEBIAN_FRONTEND=noninteractive PIP_DISABLE_PIP_VERSION_CHECK=1
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv python3-dev build-essential \
      dpkg-dev libegl1 libgl1 libxkbcommon-x11-0 libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-randr0 libxcb-render-util0 libxcb-shape0 libxcb-xinerama0 libxcb-xkb1 libnss3 libasound2t64 libxcomposite1 libxdamage1 \
      libxrandr2 libxtst6 libxi6 libxfixes3 libsnappy1v5 libopus0 libminizip1t64 libfontconfig1 libdbus-1-3 libxkbfile1 libxshmfence1 libgbm1 xvfb x11-utils \
      imagemagick fonts-dejavu xdg-utils ca-certificates openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY requirements-build.txt requirements-desktop.txt ./
RUN python3 -m venv /venv && /venv/bin/pip install -q --require-hashes --only-binary :all: -r requirements-build.txt \
      && /venv/bin/pip install -q --require-hashes --only-binary :all: --no-binary proxy-tools --no-build-isolation -r requirements-desktop.txt
COPY . .
CMD ["/venv/bin/python", "tools/build_desktop.py"]
